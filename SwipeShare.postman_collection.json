                "exec": [
                  "pm.test(\"Match creado exitosamente\", function () {\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
                  "});\r",
                  "\r",
                  "// Guarda el ID del match para poder actualizar su estado después\r",
                  "if (pm.response.code === 200 || pm.response.code === 201) {\r",
                  "    var data = pm.response.json();\r",
                  "    // Usa data.id o data.matchId según lo que responda tu backend en el JSON\r",
                  "    pm.environment.set(\"matchId\", data.id || data.matchId);\r",
